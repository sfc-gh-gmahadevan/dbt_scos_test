# Copy to .env, fill in, then: set -a && source .env && set +a
# .env is gitignored. Never commit real values.

# Include the region for locator-style accounts, e.g. AB12345.us-east-1
export SF_ACCOUNT=YOURACCT.us-east-1
export SF_USER=YOUR_USER
export SF_ROLE=YOUR_ROLE
export SF_WAREHOUSE=YOUR_WH
export SF_DATABASE=DBT_LEARN
export SF_SCHEMA=DEV

# Key-pair auth: absolute path to your encrypted private key
export SF_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
export SF_PRIVATE_KEY_PASSPHRASE=your_key_passphrase

# Name of the entry in ~/.snowflake/connections.toml used by
# `snow dbt deploy` and by Snowpark Connect.
export SNOWFLAKE_CONNECTION_NAME=your-connection-name
