# Backs the env_var() calls in profiles.yml when the project runs inside Snowflake.
# Rules: every key under env: must be UPPERCASE and DBT_-prefixed.
# Values may be plain text, or SQL in {{ }} returning one row / one varchar column.

env_config:
  default_environment: dev
  environments:
    - name: dev
      env:
        DBT_CURRENT_ROLE: "{{ select CURRENT_ROLE() }}"
        DBT_CURRENT_WH: "{{ select CURRENT_WAREHOUSE() }}"
        DBT_CURRENT_DB: DBT_LEARN
        DBT_CURRENT_SCHEMA: DEV

    - name: prod
      env:
        DBT_CURRENT_ROLE: "{{ select CURRENT_ROLE() }}"
        DBT_CURRENT_WH: "{{ select CURRENT_WAREHOUSE() }}"
        DBT_CURRENT_DB: DBT_LEARN
        DBT_CURRENT_SCHEMA: PROD
